{
  extends: [
    'config:recommended',
    ':semanticCommitTypeAll(chore)',
    ':ignoreUnstable',
    ':separateMajorReleases',
    ':prConcurrentLimitNone',
    ':prHourlyLimitNone',
    ':preserveSemverRanges',
  ],
  rebaseWhen: 'conflicted',
  dependencyDashboardLabels: [
    'type: process',
  ],
  packageRules: [
    {
      groupName: 'GitHub Actions',
      matchManagers: [
        'github-actions',
      ],
      pinDigests: true,
    },
    {
      // Label Toolbox runner bumps as `feat`. This rule only adds the commit
      // type; the datasource is set by the customManager below.
      matchPackageNames: ['@toolbox-sdk/server'],
      matchDatasources: ['npm'],
      semanticCommitType: 'feat',
    },
  ],
  customManagers: [
    {
      // Bump the MCP Toolbox runner pinned in mcp.json, checked against npm.
      customType: 'regex',
      managerFilePatterns: ['/(^|/)mcp\\.json$/'],
      matchStrings: [
        '"(?<depName>@toolbox-sdk/server)@(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"',
      ],
      datasourceTemplate: 'npm',
    },
  ],
}
