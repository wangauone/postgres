{
  extends: [
    'config:recommended',
    ':semanticCommitTypeAll(chore)',
    ':ignoreUnstable',
    ':separateMajorReleases',
    ':prConcurrentLimitNone',
    ':prHourlyLimitNone',
    ':preserveSemverRanges',
  ],
  rebaseWhen: 'conflicted',
  dependencyDashboardLabels: [
    'type: process',
  ],
  packageRules: [
    {
      groupName: 'GitHub Actions',
      matchManagers: [
        'github-actions',
      ],
      pinDigests: true,
    },
    {
      matchPackageNames: ['@toolbox-sdk/server'],
      // Group the toolbox update under a stable branch name (renovate/toolbox).
      groupName: 'toolbox',
      semanticCommitType: 'feat',
    }
  ],
  customManagers: [
    {
      // Track the npm toolbox server pinned in the MCP command. Only the
      // source (mcp.json) is bumped here; agent-plugin-sync regenerates the
      // derived manifests on the same PR.
      customType: "regex",
      managerFilePatterns: ["/^mcp\\.json$/"],
      matchStrings: ["@toolbox-sdk/server@(?<currentValue>[\\d\\.]+)"],
      datasourceTemplate: "npm",
      depNameTemplate: "@toolbox-sdk/server",
    }
  ]
}
